    {
      "name": "1. Especialidades",
      "item": [
        {
          "name": "Listar especialidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/especialidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "especialidades"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Calcula una fecha hábil futura aleatoria para que la colección se pueda ejecutar varias veces",
                  "const pad = n => String(n).padStart(2, '0');",
                  "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 7 + Math.floor(Math.random() * 300));",
                  "while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);",
                  "const sabado = new Date(d);",
                  "while (sabado.getDay() !== 6) sabado.setDate(sabado.getDate() + 1);",
                  "const bloque = Math.floor(Math.random() * 8);           // Dr. Martínez atiende 08:00-12:00 (8 bloques)",
                  "const hora = `${pad(8 + Math.floor(bloque / 2))}:${bloque % 2 ? '30' : '00'}`;",
                  "pm.collectionVariables.set('fechaCita', fmt(d));",
                  "pm.collectionVariables.set('horaCita', hora);",
                  "pm.collectionVariables.set('fechaHoraCita', `${fmt(d)}T${hora}:00`);",
                  "pm.collectionVariables.set('fechaSabado', fmt(sabado));",
                  "pm.collectionVariables.set('sufijo', String(Date.now()).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cuerpo JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Hay al menos 4 especialidades\", () => pm.expect(pm.response.json().length).to.be.at.least(4));"
                ]
              }
            }
          ]
        },
